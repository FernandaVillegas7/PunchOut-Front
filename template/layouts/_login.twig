<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="">
    <meta name="author" content="">
    <meta name="keywords" content="">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">

    <!-- Favicon -->
    <link href="public/img/favicon.png" rel="icon">
    <title>Mersol Sureste</title>

    <link rel="stylesheet" href="public/lib/sweetalert2/dist/sweetalert2.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-SgOJa3DmI69IUzQ2PVdRZhwQ+dy64/BUtbMJw1MZ8t5HZApcHrRKUc4W0kG879m7" crossorigin="anonymous">

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet" />
</head>


<body>

    <div class="container-fluid sticky-top navbarTop mb-3 p-0 m-0">
        <div class="row align-items-center bg-light py-3 px-xl-5 d-none d-lg-flex">
            <div class="col-lg-4">
                <a href="index" class="text-decoration-none">
                    <img src="public/img/logo_merosol.png" alt="Logo" class="logo" style="height: 4rem;">
                </a>
            </div>
            <div class="col-lg-4 col-6 text-start">
                <form action="">
                    <div class="input-group">
                        <input type="text" class="form-control rounded-searcher border border-danger"
                            placeholder="Buscar productos">
                        <span class="input-group-text bg-transparent text-primary rounded-searcherl border border-danger">
                            <i class="fa fa-search"></i>
                        </span>
                    </div>
                </form>
            </div>
            <div class="col-lg-4 col-8 text-end">
                <p class="m-0">Tipo de cambio: 19.85</p>
                <p class="m-0">Servicio al Cliente</p>
                <h6 class="m-0">+012 345 6789</h6>
            </div>
        </div>

        <div class="row">
            <div class="bg-danger col-12">&nbsp;</div>
        </div>
    </div>

    {% block pageContent %}{% endblock %}

    <div class="row">
        <div class="col-12 bg-danger">&nbsp;</div>
    </div>

    <div class="container-fluid bg-dark text-secondary bigfoot">
        <div class="row px-xl-5 pt-5">
            <div class="col-12">
                <h1 class="text-white">NUESTRAS SUCURSALES</h1>
                <h4 class="text-white">“SOMOS 7 TIENDAS DISTRIBUIDAS EN MÉXICO”</h4>
            </div>

            <div class="col-lg-12 col-md-12 pt-5 mb-5 pe-3 pe-xl-5">
                <div class="row">
                    {% for s in Sucursales %}
                    <div class="col-6 col-md-4 col-lg-3 mb-4">
                        <h6 class="text-danger fw-bold">
                            <i class="fas fa-map-marker-alt"></i>
                            {{s.Sucursal}}
                        </h6>
                        <p class="fw-bold">{{s.Domicilio}}</p>
                        <p class="fw-bold">Tel. {{s.Telefono}}</p>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="row border-top mx-xl-5 py-4" style="border-color: red !important;">
            <div class="col-md-4 px-xl-0 text-center text-md-start">
                <img class="img-footer" src="public/img/logo-claro.svg" alt="" style="width: 40%;">
            </div>

            <div class="col-md-4 px-xl-0 text-center">
                <p>Métodos de pago</p>
                <img class="img-fluid" src="public/img/payments.png" alt="">
            </div>

            <div class="col-md-4 text-center text-md-end">
                <ul class="list-unstyled">
                    <li>Aviso de Términos y Condiciones</li>
                    <li>Política de Devoluciones</li>
                    <li>Política de Envío</li>
                    <li>Garantías</li>
                </ul>
            </div>
        </div>

        <div class="row">
            <div class="col-12 bg-danger py-2">
                <div class="px-xl-0">
                    <p class="text-center text-white m-0">
                        &copy; 2026 Mercado de la Soldadura del Sureste, S.A. de C.V. | Derechos Reservados
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script src="public/js/jquery.min.js"></script>
    <script src="public/lib/formSerialize/frmserialize.js"></script>
    <script src="public/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-k6d4wzSIapyDyv1kpU366/PK5hCdSbCRGRCMv+eplOQJWyd1fbcAu9OCUj5zNLiq"
        crossorigin="anonymous"></script>
    <script src="public/lib/sweetalert2/dist/sweetalert2.min.js"></script>
    <script src="{{'public/js/mersolsur.js'|filemtime_version}}"></script>

    {% block extraScripts %}{% endblock %} 
</body>

</html>