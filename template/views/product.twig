{% extends "layouts/base.twig" %}

{% block pageContent %}

<div class="container-fluid">
    <div class="row px-xl-5 align-items-stretch">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" href="index">Inicio</a>
                <a class="breadcrumb-item text-dark" href="shop">Tienda</a>
                <span class="breadcrumb-item active">Detalles del producto</span>
            </nav>
        </div>
    </div>
</div>

<div class="container-fluid pb-5">
    <div class="row px-xl-5 align-items-stretch">

        <div class="col-lg-9 d-flex">
            <div class="row w-100 align-items-stretch">

                <div class="col-lg-5 mb-30">
               
                    <div class="product-img-container shadow-sm w-100 d-flex align-items-center justify-content-center" style="aspect-ratio: 1 / 1; background-color: white;">
                        <img id="product-img" class="img-fluid" src="" alt="">
                    </div>
                    <div id="contenedor-galeria" class="d-flex justify-content-center flex-wrap">
                    </div>
                </div>

                <div class="col-lg-7 mb-30 d-flex">
                    <div class="product-info-box border rounded shadow-sm h-100 w-100 d-flex flex-column">
                        
                        <div class="product-info-title">
                            <span id="product-longName"></span>
                        </div>

                        <div class="product-info-price">
                            $<span id="product-amount"></span> <span id="product-currency"></span>
                        </div>

                        <div class="product-info-code pb-2 border-bottom">
                            Fabricante: <strong><span id="product-manufacturer"></span></strong> |
                            Código: <strong><span id="product-codigoInterno"></span></strong>
                        </div>

                        <form id="frmProducto" class="mt-4 pt-2">
                            <input type="hidden" name="codigo" id="input-codigo" value="">
                            <input type="hidden" name="nombre" id="input-nombre" value="">
                            <input type="hidden" name="precio" id="input-precio" value="">
                            <input type="hidden" name="articulo" id="input-articulo" value="">

                            <div class="row w-100 align-items-center">
                                <div class="col-md-4 mb-3 mb-md-0">
                                    <div class="input-group b2b-quantity-input">
                                        <button class="btn btn-minus" type="button">
                                            <i class="fa fa-minus"></i>
                                        </button>

                                        <input type="text" name="totalProducto" id="totalProducto" class="form-control" value="1">

                                        <button class="btn btn-plus" type="button">
                                            <i class="fa fa-plus"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="col-md-8">
                                    <button class="btn-b2b-cart" id="btAddCar" type="button">
                                        <i class="fas fa-cart-plus mr-3"></i> Agregar al carrito
                                    </button>
                                </div>

                                <div class="col-12">
                                    <div id="product-stock-status" class="mt-3 mb-2"></div>
                                </div>
                                <div id="contenedor-promociones" class="mt-3"></div>
                            </div>
                        </form>

                        <div class="b2b-details-section mt-5 pt-4">
                            <div class="b2b-details-header" data-target="#content-detalles">
                                <div class="b2b-details-title">
                                    <i class="fas fa-list-ul"></i> Detalles del Producto
                                </div>
                                <button class="btn-b2b-trigger collapsed" id="trigger-detalles" type="button">
                                    <i class="fas fa-chevron-down"></i>
                                </button>
                            </div>

                            <div id="content-detalles" class="mt-4" style="display: none;">
                                <div class="mb-4">
                                    <h6 class="font-weight-bold text-dark mb-2">Descripción General</h6>
                                    
                                    <div class="text-preview-wrapper" id="desc-wrapper">
                                        <div id="product-long-description" class="product-description-text">
                                            </div>
                                    </div>

                                    <button type="button" class="btn-read-more" id="btn-read-more" onclick="toggleReadMore()">
                                        Ver más <i class="fas fa-chevron-down"></i>
                                    </button>
                                </div>

                                <h6 class="font-weight-bold text-dark mb-2">Especificaciones Técnicas</h6>
                                <div class="table-responsive">
                                    <table class="table table-specifications w-100">
                                        <tbody id="tabla-especificaciones"></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="b2b-details-section" id="caja-seccion-similares" style="display:none;">
                            <div class="b2b-details-header" data-target="#seccion-equivalentes">
                                <div class="b2b-details-title">
                                    <i class="fas fa-layer-group"></i> Artículos similares
                                </div>
                                <button class="btn-b2b-trigger collapsed" id="trigger-similares" type="button">
                                    <i class="fas fa-chevron-down"></i>
                                </button>
                            </div>
                        </div>

                        <div class="b2b-details-section" id="caja-seccion-complementarios" style="display:none;">
                            <div class="b2b-details-header" data-target="#seccion-complementarios">
                                <div class="b2b-details-title">
                                    <i class="fas fa-handshake"></i> Comprados juntos
                                </div>
                                <button class="btn-b2b-trigger collapsed" id="trigger-complementarios" type="button">
                                    <i class="fas fa-chevron-down"></i>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>

        <div class="col-lg-3 mb-30 d-flex" id="seccion-complementarios" style="display:none;">
            <div class="border rounded shadow-sm bg-white p-3 h-100 w-100 d-flex flex-column">
                
                <div class="d-flex align-items-center mb-4 pb-2" style="border-bottom: 2px solid #eaeaea;">
                    <div style="background: linear-gradient(135deg, #d2242a 0%, #403B33 100%); width: 4px; height: 24px; border-radius: 4px; margin-right: 12px;"></div>
                    <h5 class="mb-0 font-weight-bold" style="color: #3D464D; letter-spacing: 0.3px; font-size: 1.1rem;">
                        Comprados juntos
                    </h5>
                </div>

                <div id="contenedor-complementarios" class="d-flex flex-column flex-grow-1 overflow-auto" style="height: 0;">
                    </div>

            </div>
        </div>

    </div>

    <div class="row mt-5" id="seccion-equivalentes" style="display:none;">
        <div class="col-12 px-xl-5 pt-4">
            
            <div class="d-flex align-items-center mb-4 pb-3" style="border-bottom: 2px solid #eaeaea;">
                <div style="background: linear-gradient(135deg, #d2242a 0%, #403B33 100%); width: 5px; height: 28px; border-radius: 4px; margin-right: 15px;"></div>
                <h4 class="mb-0 font-weight-bold" style="color: #000000; letter-spacing: 0.3px;">
                    Opciones y equivalentes
                </h4>
                <span class="badge ml-3" style="background-color: #f0ebeb; color: #5c508a; font-size: 0.75rem; padding: 0.5em 0.8em; border-radius: 20px; font-weight: 600;">
                    <i class="fas fa-star mr-1" style="font-size: 0.65rem;"></i> Recomendados
                </span>
            </div>

            <div class="row gap-sm justify-content-center" id="contenedor-equivalentes"></div>
        </div>
    </div>
</div>

{% endblock %}

{% block extraScripts %}
    {{ parent() }}
    <script src="{{ 'public/js/src/producto.js'|filemtime_version }}"></script>
    <link rel="stylesheet" href="public/css/product.css">
{% endblock %}