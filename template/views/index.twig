{% extends "layouts/base.twig" %}

{% block pageContent %}

<div class="container-fluid carouselForma p-0 m-0">
    <div class="row g-0">
        <div class="col-lg-8">
            <div id="header-carousel" class="carousel slide carousel-fade mb-3 mb-lg-0" data-bs-ride="carousel" data-bs-interval="10000">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#header-carousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#header-carousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                </div>

                <div class="carousel-inner" style="height: 450px;">
                    <div class="carousel-item active position-relative" style="height: 430px;">
                        <img src="public/img/asset 10.png" class="d-block w-100 h-100 position-absolute" style="object-fit: cover;" alt="Slide 1">
                        <div class="cell-overlay position-absolute w-100 h-100" style="top:0;left:0;pointer-events:none;"></div>
                        <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                            <div class="p-3" style="max-width: 700px;">
                                <h3 class="text-white mb-3 animate__animated animate__fadeInDown">Mersol Sureste</h3>
                                <h6 class="text-white text-uppercase mx-md-5 px-5 animate__animated animate__bounceIn">
                                    Gracias por confiar en nosotros. En Mersol Sureste trabajamos cada día para ofrecerte soluciones confiables y un servicio de calidad que impulse el crecimiento de tu empresa. ¡Estamos para apoyarte en todo momento!
                                </h6>
                            </div>
                        </div>
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#header-carousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Anterior</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#header-carousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Siguiente</span>
                </button>
            </div>
        </div>

        <!-- Offers Section -->
        <div class="col-lg-4">
            <div class="product-offer position-relative overflow-hidden mb-3" style="height: 215px;">
                <img src="public/img/asset 30.jpeg" class="img-fluid w-100 h-100" style="object-fit: cover;" alt="Oferta 1">
                <div class="offer-text position-absolute top-50 start-50 translate-middle text-center">
                    <h6 class="text-white text-uppercase">Consulta tus</h6>
                    <h3 class="text-white mb-3">Cotizaciones</h3>
                    <a href="misCotizaciones" class="btn btn-secondary">Dando click aqui</a>
                </div>
            </div>

            <div class="product-offer position-relative overflow-hidden" style="height: 215px;">
                <img src="public/img/asset 29.jpeg" class="img-fluid w-100 h-100" style="object-fit: cover;" alt="Oferta 2">
                <div class="offer-text position-absolute top-50 start-50 translate-middle text-center">
                    <h6 class="text-white text-uppercase">Comunicate con tu </h6>
                    <h3 class="text-white mb-3">Asesor de ventas</h3>
                    <a href="https://wa.me/5218141716624" class="btn btn-secondary">Dando click aqui</a>
                </div>
            </div>
        </div>
    </div>
</div>


