{% extends "layouts/base.twig" %}

{% block pageContent %}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <h2 class="text-center mb-4">¿Qué hacer si...?</h2>
            <p class="text-center text-muted mb-5">
                Selecciona una pregunta para ver la respuesta.
            </p>

            <div class="accordion custom-accordion" id="faqAccordion">

                {# ITEM 1 #}
                <div class="accordion-item mb-3 shadow-sm border-0">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed fw-semibold"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#faq1">
                            ¿Por qué el precio en mi carrito no coincide con el del catálogo?
                        </button>
                    </h2>

                    <div id="faq1"
                         class="accordion-collapse collapse"
                         data-bs-parent="#faqAccordion">

                        <div class="accordion-body">
                            <p>El precio del catálogo es el <strong>precio unitario base</strong>.</p>

                            <p>
                                Si agregas volumen suficiente se aplica el descuento automáticamente.
                            </p>

                            <div class="alert alert-warning mt-3">
                                Antes de IVA 
                            </div>
                        </div>
                    </div>
                </div>


                {# ITEM 2 #}
                <div class="accordion-item mb-3 shadow-sm border-0">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed fw-semibold"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#faq3">
                            No encuentro el código exacto que busco, ¿qué hago?
                        </button>
                    </h2>

                    <div id="faq3"
                         class="accordion-collapse collapse"
                         data-bs-parent="#faqAccordion">

                        <div class="accordion-body">

                            <ol>
                                <li>Busca por palabra clave</li>
                                <li>Revisa productos del giro</li>
                                <li>Usa equivalentes</li>
                            </ol>

                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>
{% endblock %}

{% block extraStyles %}
<link rel="stylesheet" href="public/css/preguntas.css">
{% endblock %}