{% extends "layouts/_login.twig" %}

{% block pageContent %}
<div class="container">
    <div class="row align-items-center" style="min-height: 100vh;">
        <!-- Imagen a la izquierda -->
        <div class="col-md-6 text-center border-end" style="padding: 2rem;">
            <div class="mx-auto d-block" style="max-width: 500px; aspect-ratio: 1 / 1; overflow: hidden;">
                <img class="img-fluid h-100 w-100 object-fit-cover" src="public/img/soldadura-2.webp" alt="soldadura">
            </div>
        </div>

        <div class="col-md-6 d-flex align-items-center">
            <form class="ps-4 w-100" style="max-width: 500px; margin: 0 auto;" id="frmLogin">
                <h2 class="mb-3">Iniciar sesión</h2>

                <div class="mb-3">
                    <label for="usuario" class="form-label">Correo electrónico</label>
                    <input class="form-control" type="email" name="usuario" id="usuario" placeholder="Correo electrónico" required>
                </div>

                <div class="mb-3">
                    <label for="userPass" class="form-label">Contraseña</label>
                    <input class="form-control" type="password" name="userPass" id="userPass" placeholder="Contraseña" required>
                </div>

                <div class="mb-3">
                    <button class="btn btn-danger w-100" id="btLogin" type="submit">Iniciar sesión</button>
                </div>

                <div class="mb-3 text-center">
                    <small id="loginError" class="text-danger" style="display: none;">Por favor, ingrese sus credenciales correctamente.</small>
                </div>
                <div class="mb-3 text-center">
                    <a href="#" class="text-danger" data-bs-toggle="modal" data-bs-target="#solicitudAccesoModal">
                        ¿No tienes acceso? <strong>Solicítalo aquí</strong>
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Bootstrap -->
<div class="modal fade" id="authModal" tabindex="-1" aria-labelledby="authModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered"> <!-- Centrar el modal -->
        <div class="modal-content" style="border-radius: 0;"> <!-- Sin bordes redondos -->
            <div class="modal-header">
                <h5 class="modal-title" id="authModalLabel">Ingrese el código recibido en el chat de WhatsApp</h5>
            </div>
            <div class="modal-body">
                <form id="authForm">
                    <div class="mb-3">
                        <label for="codigo" class="form-label">Código</label>
                        <input type="text" class="form-control" name="codigo" id="codigo" placeholder="Código" required>
                    </div>
                    <button type="submit" class="btn btn-danger w-100" color: white;">Enviar</button> <!-- Botón en rojo oscuro -->
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="solicitudAccesoModal" tabindex="-1" aria-labelledby="solicitudAccesoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 0;">
            <div class="modal-header">
                <h5 class="modal-title" id="solicitudAccesoModalLabel">Solicitud de acceso para clientes</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3 text-muted">
                    Si eres cliente y aún no tienes acceso a la plataforma, por favor llena el siguiente formulario y nuestro equipo se pondrá en contacto contigo.
                </p>
                <form id="formSolicitudAcceso">
                {# <div class="alert alert-info text-center mb-4" role="alert">
                    Este formulario es exclusivo para clientes que desean solicitar acceso a la plataforma. Por favor, completa todos los campos y nos pondremos en contacto contigo a la brevedad.
                </div> #}
                <div class="mb-3">
                    <label for="empresa" class="form-label">Nombre de la empresa</label>
                    <input type="text" class="form-control" id="empresa" name="empresa" required>
                </div>
                <div class="mb-3">
                    <label for="solicitante" class="form-label">Nombre de quien solicita</label>
                    <input type="text" class="form-control" id="solicitante" name="solicitante" required>
                </div>
                <div class="mb-3">
                    <label for="correoSolicitud" class="form-label">Correo electrónico</label>
                    <input type="email" class="form-control" id="correoSolicitud" name="correoSolicitud" required>
                </div>
                <div class="mb-3">
                    <label for="telefonoSolicitud" class="form-label">Número de teléfono</label>
                    <input type="tel" class="form-control" id="telefonoSolicitud" name="telefonoSolicitud" required>
                </div>
                <div class="mb-3">
                    <label for="mensajeSolicitud" class="form-label">Mensaje (opcional)</label>
                    <textarea class="form-control" id="mensajeSolicitud" name="mensajeSolicitud" rows="2" maxlength="250" placeholder="Escribe un mensaje corto..."></textarea>
                </div>
                <button type="submit" class="btn btn-danger w-100">Enviar solicitud</button>
                <div id="solicitudAccesoMsg" class="mt-3" style="display:none;"></div>
            </div>
        </div>
    </div>
</div>


{% endblock %}




{% block extraScripts %}
<style>
    /* Estado de carga */
    #btLogin.loading {
        width: 3rem;
        height: 3rem;
        transition: all 0.3s ease-in-out;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        padding: 0;
    }

    /* Estado de error */
    #btLogin.error {
        width: auto;
        height: auto;
        transition: all 0.3s ease-in-out;
        background-color: #000;
        color: #fff;
        border-radius: 0.25rem;
    }

    /* Estado de éxito */
    #btLogin.success {
        width: auto;
        height: auto;
        transition: all 0.3s ease-in-out;
        background-color: #28a745;
        color: #fff;
        border-radius: 0.25rem;
    }
</style>
<script src="{{'public/js/src/login.js'|filemtime_version}}"></script>
{% endblock %}
