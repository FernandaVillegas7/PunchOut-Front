{% extends "layouts/base.twig" %}

{% block pageContent %}

	<div class="container-fluid">
		<div class="row px-xl-5">
			<div class="col-12">
				<nav class="breadcrumb bg-light mb-30" aria-labelledby="??">
					<a class="breadcrumb-item text-dark" href="index">Inicio</a>
					<a class="breadcrumb-item text-dark" href="#">Tienda</a>
					<span class="breadcrumb-item active">Lista de productos</span>
				</nav>
			</div>
		</div>
	</div>

	<div class="container-fluid">
		<div class="row px-xl-5">
			<div
				class="col-lg-3 col-md-4">

				{# Search arriba de los filtros #}
				<div class="mb-4">
					<form action="" id="productSearchForm">
						<div class="input-group flex-nowrap">
							<input type="text" class="form-control" id="productSearchInput" placeholder="Buscar" aria-label="Buscar" aria-describedby="addon-wrapping">
							<span class="input-group-text" id="addon-wrapping" style="cursor:pointer">
								<i class="fa fa-search"></i>
							</span>
						</div>
					</form>
				</div>

				<h5 class="section-title position-relative text-uppercase mb-3">
					<span class="pr-3">
						FILTRAR POR
					</span>
				</h5>

				<div
					id="exiros-categories" class="mb-4">
					<!-- Categorías cargadas dinámicamente -->
					<div class="text-muted small">Cargando categorías...</div>
				</div>
			</div>

			<div class="col-lg-9 col-md-8">
				<div class="row pb-3 itemScroll">
					<div class="col-12 pb-1">
						<div class="d-flex align-items-center justify-content-between mb-4">
							<div>&nbsp;</div>
						</div>
					</div>
				</div>
			</div>
			<div class="col-12 text-center my-3">
				<button id="btnShowMore" class="btn btn-outline-primary">Mostrar más productos</button>
			</div>
		</div>
	</div>

{% endblock %}

{% block extraScripts %}
	{# {{ parent() }}
	    <script src="{{'public/js/src/b2bProducts.js'|filemtime_version}}"></script> #}
	{{ parent() }}
	<script>
		// Validación global de sesión para PunchOut/OCI en Compra Rápida
(function () {
var ERROR_URL = 'https://exiros.mersolsureste.com.mx/errors/401';
try {
var params = new URLSearchParams(window.location.search);
var fromUrl = params.get('SessionID');
var sid = fromUrl || (sessionStorage.getItem('punchoutSessionID') || '');

if (! sid) {
window.location.replace(ERROR_URL);
return;
}

// Persistir el SessionID para siguientes requests
try {
sessionStorage.setItem('punchoutSessionID', sid);
} catch (e) {}

// Validar en servidor y anclar cookie de sesión PHP para las llamadas AJAX posteriores
fetch('app/api/exiros.php?method=validateSessionID', {
method: 'POST',
headers: {
'Content-Type': 'application/json'
},
body: JSON.stringify(
{SessionID: sid}
)
}).then(function (res) {
if (! res.ok) 
throw new Error('HTTP ' + res.status);

return res.json();
}).then(function (json) {
if (! json || json.error) {
window.location.replace(ERROR_URL);
}
}).catch(function () {
window.location.replace(ERROR_URL);
});
} catch (e) {
window.location.replace(ERROR_URL);
}
})();
// Nota: CompraRapida.js debe leer sessionStorage('punchoutSessionID') si necesita adjuntar el parámetro en URLs
	</script>
	<script src="{{'public/js/src/b2bProducts.js'|filemtime_version}}"></script>
{% endblock %}
