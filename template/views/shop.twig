{% extends "layouts/base.twig" %}

{% block pageContent %}

	<div class="container-fluid">
		<div class="row px-xl-5">
			<div class="col-12">
				<nav class="breadcrumb bg-light mb-30" aria-labelledby="??">
					<a class="breadcrumb-item text-dark" href="index">Inicio</a>
					<a class="breadcrumb-item text-dark" href="#">Tienda</a>
					<span class="breadcrumb-item active">Lista de productos</span>
				</nav>
			</div>
		</div>
	</div>

	<div class="container-fluid">
		<div class="row px-xl-5">
			<div
				class="col-lg-3 col-md-4">

				<div class="mb-4">
					<form action="" id="productSearchForm">
						<div class="input-group">
							<input type="text" class="form-control border-secondary" id="productSearchInput" placeholder="Buscar: código, producto, palabra" aria-label="Buscar">
							
							<button class="btn btn-outline-secondary btn-animado" type="submit" id="btnSearch">
								<i class="fa fa-search"></i>
								<span class="btn-texto">Buscar</span>
							</button>
							
							<button class="btn btn-outline-secondary btn-animado" type="button" id="btnHelp" data-bs-toggle="modal" data-bs-target="#helpModal">
								<i class="fa-solid fa-question"></i>
								<span class="btn-texto">Preguntas</span>
							</button>
						</div>
					</form>

					
				</div>

				<div class="mb-4 position-relative d-flex justify-content-center">
					<div class="sparkle-button">
						<button id="btnActualizacion" type="button" data-bs-toggle="modal" data-bs-target="#helpActualizacion">
							<span class="spark"></span>
							<span class="backdrop"></span>
							<svg class="sparkle" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
								<path d="M14.187 8.096L15 5.25L15.813 8.096C16.0231 8.83114 16.4171 9.50062 16.9577 10.0413C17.4984 10.5819 18.1679 10.9759 18.903 11.186L21.75 12L18.904 12.813C18.1689 13.0231 17.4994 13.4171 16.9587 13.9577C16.4181 14.4984 16.0241 15.1679 15.814 15.903L15 18.75L14.187 15.904C13.9769 15.1689 13.5829 14.4994 13.0423 13.9587C12.5016 13.4181 11.8321 13.0241 11.097 12.814L8.25 12L11.096 11.187C11.8311 10.9769 12.5006 10.5829 13.0413 10.0423C13.5819 9.50162 13.9759 8.83214 14.186 8.097L14.187 8.096Z" fill="black" stroke="black" stroke-linecap="round" stroke-linejoin="round" />
								<path d="M6 14.25L5.741 15.285C5.59267 15.8785 5.28579 16.4206 4.85319 16.8532C4.42059 17.2858 3.87853 17.5927 3.285 17.741L2.25 18L3.285 18.259C3.87853 18.4073 4.42059 18.7142 4.85319 19.1468C5.28579 19.5794 5.59267 20.1215 5.741 20.715L6 21.75L6.259 20.715C6.40725 20.1216 6.71398 19.5796 7.14639 19.147C7.5788 18.7144 8.12065 18.4075 8.714 18.259L9.75 18L8.714 17.741C8.12065 17.5925 7.5788 17.2856 7.14639 16.853C6.71398 16.4204 6.40725 15.8784 6.259 15.285L6 14.25Z" fill="black" stroke="black" stroke-linecap="round" stroke-linejoin="round" />
								<path d="M6.5 4L6.303 4.5915C6.24777 4.75718 6.15472 4.90774 6.03123 5.03123C5.90774 5.15472 5.75718 5.24777 5.5915 5.303L5 5.5L5.5915 5.697C5.75718 5.75223 5.90774 5.84528 6.03123 5.96877C6.15472 6.09226 6.24777 6.24282 6.303 6.4085L6.5 7L6.697 6.4085C6.75223 6.24282 6.84528 6.09226 6.96877 5.96877C7.09226 5.84528 7.24282 5.75223 7.4085 5.697L8 5.5L7.4085 5.303C7.24282 5.24777 7.09226 5.15472 6.96877 5.03123C6.84528 4.90774 6.75223 4.75718 6.697 4.5915L6.5 4Z" fill="black" stroke="black" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
							
							<span class="text">Actualizaciones</span>
						</button>
						
						<div class="bodydrop"></div>
						
						<span aria-hidden="true" class="particle-pen">
							{% for i in 1..15 %}
							<svg class="particle" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
								<path d="M6.937 3.846L7.75 1L8.563 3.846C8.77313 4.58114 9.1671 5.25062 9.70774 5.79126C10.2484 6.3319 10.9179 6.72587 11.653 6.936L14.5 7.75L11.654 8.563C10.9189 8.77313 10.2494 9.1671 9.70874 9.70774C9.1681 10.2484 8.77413 10.9179 8.564 11.653L7.75 14.5L6.937 11.654C6.72687 10.9189 6.3329 10.2494 5.79226 9.70874C5.25162 9.1681 4.58214 8.77413 3.847 8.564L1 7.75L3.846 6.937C4.58114 6.72687 5.25062 6.3329 5.79126 5.79226C6.3319 5.25162 6.72587 4.58214 6.936 3.847L6.937 3.846Z" fill="black" stroke="black" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
							{% endfor %}
						</span>
					</div>
				</div>

				<h5 class="section-title position-relative text-uppercase mb-3">
					<span class="pr-3">
						FILTRAR POR
					</span>
				</h5>

				<div
					id="exiros-categories" class="mb-4">
					<!-- Categorías cargadas dinámicamente -->
					<div class="text-muted small">Cargando categorías...</div>
				</div>
			</div>

			<div class="col-lg-9 col-md-8">
				<div class="row pb-3 itemScroll">
					<div class="col-12 pb-1">
						<div class="d-flex align-items-center justify-content-between mb-4">
							<div>&nbsp;</div>
						</div>
					</div>
				</div>
			</div>
			<div class="col-12 text-center my-3">
				<button id="btnShowMore" class="btn btn-outline-primary">Mostrar más productos</button>
			</div>
		</div>
	</div>


	<div class="modal fade" id="helpModal" tabindex="-1" aria-labelledby="helpModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      
      <div class="modal-header bg-light">
        <h5 class="modal-title fw-bold" id="helpModalLabel">
            <i class="fa-solid fa-circle-info text-primary me-2"></i>¿Cómo buscar en B2B?
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>

      <div class="modal-body">
        <p class="mb-3 text-muted">Nuestro buscador inteligente te ayuda a encontrar productos rápidamente. Puedes intentar buscar por:</p>
        
        <div class="list-group list-group-flush">
            <div class="list-group-item d-flex align-items-center px-0">
                <div class="bg-primary bg-opacity-10 p-2 rounded-circle me-3 text-primary">
                    <i class="fa fa-barcode"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold">Código o SKU</h6>
                    <small class="text-muted">Ejemplo: <span class="badge bg-light text-dark border">FETU-001270</span></small>
                </div>
            </div>

            <div class="list-group-item d-flex align-items-center px-0">
                <div class="bg-success bg-opacity-10 p-2 rounded-circle me-3 text-success">
                    <i class="fa fa-tag"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold">Nombre del Producto</h6>
                    <small class="text-muted">Ejemplo: "Taladro percutor", "Lijadora"</small>
                </div>
            </div>

            <div class="list-group-item d-flex align-items-center px-0">
                <div class="bg-warning bg-opacity-10 p-2 rounded-circle me-3 text-warning">
                    <i class="fa fa-magnifying-glass"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold">Palabras Clave</h6>
                    <small class="text-muted">Características como "Inalámbrico", "18V"</small>
                </div>
            </div>
        </div>

        <div class="alert alert-info mt-3 mb-0 py-2 d-flex align-items-center" role="alert">
            <i class="fa-solid fa-lightbulb me-2 fs-5"></i>
            <small>Tip: Usa códigos exactos para resultados más precisos.</small>
        </div>
      </div>

      <div class="modal-footer border-top-0">
        <button type="button" class="btn btn-danger w-100 rounded-pill" data-bs-dismiss="modal">¡Entendido!</button>
      </div>

    </div>
  </div>
</div>




<div class="modal fade" id="helpActualizacion" tabindex="-1" aria-labelledby="helpActualizacionLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
            
            <div class="modal-header bg-light border-0 py-4 px-4">
                <div>
                    <h4 class="modal-title fw-bold text-dark" id="helpActualizacionLabel">
                        <i class="fa-solid fa-circle-info text-danger me-2"></i> Actualizaciones para ti
                    </h4>
                    <p class="text-muted mb-0 small">Conoce las herramientas que hemos diseñado para ti</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body bg-white px-4 pb-4 pt-2">
                <div class="row g-3">
                    
                    <div class="col-md-6">
                        <div class="p-3 border rounded-3 h-100 d-flex align-items-start hover-effect">
                            <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle me-3">
                                <i class="fa-solid fa-bolt fs-4"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-1">Compra Rápida</h6>
                                <p class="text-muted small mb-0">
                                    ¿Ya te sabes los códigos? Ingresa múltiples SKUs y cantidades directamente para llenar tu carrito en segundos.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 border rounded-3 h-100 d-flex align-items-start hover-effect">
                            <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle me-3">
                                <i class="fa-solid fa-shopping-bag fs-4"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-1">Mis Compras</h6>
                                <p class="text-muted small mb-0">
                                    ¿Tienes tu folio de cliente?, Consulta tu historial completo de pedidos, conocerás la fecha, importe, productos. ¿Quieres volver a pedirlos?, solo da click en ¡"Volver a comprar"!
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 border rounded-3 h-100 d-flex align-items-start hover-effect">
                            <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle me-3">
                                <i class="fa-solid fa-file-invoice-dollar fs-4"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-1">Mis Cotizaciones</h6>
                                <p class="text-muted small mb-0">
                                    ¿Cotizaste con alguno de nuestros asesores?, ¡no tienes que registrar nada!, convierte tu cotizacion en una compra al instante, firmes con un solo clic.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 border rounded-3 h-100 d-flex align-items-start hover-effect">
                            <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle me-3">
                                <i class="fa-brands fa-readme fs-4"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-1">¿Qué hacer si...?</h6>
                                <p class="text-muted small mb-0">
                                    Encuentra soluciones rápidas a problemas comunes: stock, facturación, devoluciones y dudas técnicas.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="p-3 border rounded-3 bg-light d-flex align-items-center">
                            <div class="bg-secondary bg-opacity-10 text-secondary p-2 rounded-circle me-3">
                                <i class="fa-solid fa-store fs-5"></i>
                            </div>
                            <div>
                                <span class="fw-bold text-dark d-block">Catálogo Completo</span>
                                <span class="text-muted small">Explora miles de productos utilizando nuestros filtros avanzados por marca y categoría.</span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <div class="modal-footer bg-light border-0 justify-content-between px-4 py-3">
                <span class="text-muted small fst-italic">Estamos para ayudarte en cada paso.</span>
                <button type="button" class="btn btn-dark px-4 rounded-pill" data-bs-dismiss="modal">Entendido</button>
            </div>
        </div>
    </div>
</div>


{% endblock %}

{% block extraScripts %}
	{# {{ parent() }}
	    <script src="{{'public/js/src/b2bProducts.js'|filemtime_version}}"></script> #}
	{{ parent() }}
	<script>
		// Validación global de sesión para PunchOut/OCI en Compra Rápida
(function () {
var ERROR_URL = 'https://exiros.mersolsureste.com.mx/errors/401';
try {
var params = new URLSearchParams(window.location.search);
var fromUrl = params.get('SessionID');
var sid = fromUrl || (sessionStorage.getItem('punchoutSessionID') || '');

if (! sid) {
window.location.replace(ERROR_URL);
return;
}

// Persistir el SessionID para siguientes requests
try {
sessionStorage.setItem('punchoutSessionID', sid);
} catch (e) {}

// Validar en servidor y anclar cookie de sesión PHP para las llamadas AJAX posteriores
fetch('app/api/exiros.php?method=validateSessionID', {
method: 'POST',
headers: {
'Content-Type': 'application/json'
},
body: JSON.stringify(
{SessionID: sid}
)
}).then(function (res) {
if (! res.ok) 
throw new Error('HTTP ' + res.status);

return res.json();
}).then(function (json) {
if (! json || json.error) {
window.location.replace(ERROR_URL);
}
}).catch(function () {
window.location.replace(ERROR_URL);
});
} catch (e) {
window.location.replace(ERROR_URL);
}
})();
// Nota: CompraRapida.js debe leer sessionStorage('punchoutSessionID') si necesita adjuntar el parámetro en URLs

document.addEventListener('DOMContentLoaded', () => {

    const modalId = 'helpActualizacion';
    const storageKey = 'modalActualizacionVista_v1'; 

    if (!localStorage.getItem(storageKey)) {

        const modal = new bootstrap.Modal(document.getElementById(modalId));
        modal.show();

        localStorage.setItem(storageKey, 'true');
    }

});
	</script>
	<script src="public/js/src/tutorial.js"></script>
	<script src="{{'public/js/src/b2bProducts.js'|filemtime_version}}"></script>
{% endblock %}
