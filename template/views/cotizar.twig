{% extends "layouts/base.twig" %}

{% block extraStyles %}

{% endblock %}

{% block pageContent %}  

<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-md-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" href="index">Inicio</a>
                <a class="breadcrumb-item text-dark" href="shop">Tienda</a>
                <span class="breadcrumb-item active">Compra rapida</span>
            </nav>
        </div>
    </div>
</div>

<div class="container-fluid pb-5">
    <div class="row px-xl-5">
        <div class="col-md-8">
            <div class="card" id="rapida">
                <div class="card-body">
                    <form id="frmArticulos">
                        <div class="row g-3">
                        <h3 class="fw-bold text-dark">Compra rápida</h3>
                            <h5 class="text-secondary fs-6">
                                Agrega productos por código o descripción rápidamente, en un solo lugar
                            </h5>
                            <div class="col-12 col-md-8">
                                <div class="form-group" id="seleccion">
                                    <label for="articulo">Articulo</label>
                                    <select class="form-select " name="articulo" id="articulo">
                                        <option value="-1"> Busca por código, nombre, descripción -</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-6 col-md-2">
                              <div class="form-group">
                                <label for="cantidad">Cantidad</label>
                                <input class="form-control" type="number" id="cantidad" name="cantidad" value="1" min="1" step="1" inputmode="numeric" pattern="[0-9]*" placeholder="1" autocomplete="off">
                              </div>
                            </div>
                            <div class="col-6 col-md-2 d-flex align-items-end">
                                <div class="form-group w-100">
                                    <button class="btn btn-dark w-100" id="btnAgregar" tooltip="Agregar a la canasta">
                                        <i class="fa-solid fa-cart-plus"></i> Agregar a la lista
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>

                    <table class="table table-hover text-center mb-0 mt-4" id="tbListItems">
                        <thead class="border">
                            <th>#</th>
                            <th class="col-md-1">Code</th>{# supplierPartID #}
                            <th>Marca</th>{# manufacturer #}
                            {#<th class="d-none">buyerPartID</th>  oculto #}
                            {#<th class="d-none">supplierPartAuxiliaryID</th> {# oculto #}
                            {#<th class="d-none">currency</th>{# oculto #}
                            {#<th class="d-none">shortName</th>{# oculto #}
                            {#<th>Categoria</th> category #}
                            {#<th class="d-none">codigoInterno</th> {# oculto #}
                            <th>Nombre</th>{# longName #}
                           {# <th class="d-none">materialGroup</th> {# oculto #}
                            <th>Unidad</th>{# unitOfMeasure #}
                            <th>Precio</th>{#  #}
                            <th>Cantidad</th>{# quantity #}
                            <th>SubTotal</th>{# oculto #}
                            <th></th>{# oculto #}
                            <th>&nbsp;</th>
                        </thead>
                        <tbody id="itemList">
                            <tr>
                                <td colspan="8">No se ha ingresado ningun articulo</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card mb-4" id="resumen">
                <div class="card-body">
                    <h5 class="section-title position-relative text-uppercase mb-3">
                        <span class="pr-3">Resumen</span>
                    </h5>
                    <div class="d-flex justify-content-between mt-2">
                        <h5>Total</h5>
                        <h5 id="totalItems">$ 0.00</h5>
                    </div>
                    <button class="btn btn-dark w-100 mt-3" id="btnSolicitar" tooltip="Procesar pedido">
                        <i class="fa-solid fa-cash-register"></i> Procesar Pedido
                    </button>
                    <button class="btn btn-outline-primary w-100 mt-2" id="btnEnviarOCI" tooltip="Enviar OCI al PunchOut" style="display:none;">
                        <i class="fa-solid fa-share-from-square"></i> Enviar OCI
                    </button>
                    <div id="jsonPreviewContainer" class="mt-3" style="display:none;">
                        <h6 class="text-muted mb-2">Vista previa JSON</h6>
                        <pre id="jsonPreview" class="bg-light p-2 small border rounded mb-0" style="max-height: 320px; overflow: auto;"></pre>
                    </div>
                    <div id="alertsContainer"></div>

                </div>
            </div>
        </div>
    </div>
</div>

{# // C G R L #}
{# Sidebar para mostrar pedidos #}
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasPedidos" aria-labelledby="offcanvasPedidosLabel">
  <div class="offcanvas-header">
    <h5 class="offcanvas-title" id="offcanvasPedidosLabel">
      <i class="fa-solid fa-clock-rotate-left me-2"></i>Últimos pedidos
    </h5>
    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
  </div>
      <div class="offcanvas-body p-0 d-flex flex-column">
        <div class="p-3 bg-light border-bottom">
      <div class="input-group input-group-sm">
        <span class="input-group-text bg-white border-end-0">
          <i class="fa-solid fa-magnifying-glass text-muted"></i>
        </span>
        <input id="buscarPedido" type="search" 
              class="form-control border-start-0" 
              placeholder="Ingrese código de cliente">
        <button class="btn btn-danger" id="btnBuscarPedido" type="button">
          <i class="fa-solid fa-arrow-right"></i>
        </button>
      </div>
      <small class="form-text text-muted ms-1">
        Escriba el código de cliente y presione <kbd>Enter</kbd> o el botón para ver su historial de compras
      </small>
    </div>
    <ul id="listaPedidos" class="list-group list-group flush-border-top">
    </ul>
  </div>
</div>


{# // C G R L #}
<!-- Botón flotante para abrir el sidebar -->
<button class="fab-pedidos"
        type="button"
        data-bs-toggle="offcanvas"
        data-bs-target="#offcanvasPedidos"
        aria-controls="offcanvasPedidos"
        title="Últimos pedidos">
  <i class="fa-solid fa-basket-shopping fa-bounce"></i>
</button>


{# // Carga tarjetas #}
 <div class="container-fluid px-0 mt-5">
    <div id="sugerenciasContainer" class="bg-white shadow-sm rounded p-4 border mt-5">
      <div class="section-divider">
      <span> Artículos sugeridos para ti</span>
    </div>
    <div id="sugerenciasGrid"
           class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3 justify-content-evenly">
        <!-- Aquí se renderizan las tarjetas -->
    </div>
  </div>
</div>

{% endblock %}

{% block extraScripts %}
{{ parent() }}



<script>

// Validación global de sesión para PunchOut/OCI en Compra Rápida
(function () {
    var ERROR_URL = 'https://exiros.mersolsureste.com.mx/errors/401';
    try {
        var params = new URLSearchParams(window.location.search);
        var fromUrl = params.get('SessionID');
        var sid = fromUrl || (sessionStorage.getItem('punchoutSessionID') || '');

        if (!sid) {
            window.location.replace(ERROR_URL);
            return;
        }

        // Persistir el SessionID para siguientes requests
        try {
            sessionStorage.setItem('punchoutSessionID', sid);
        } catch (e) {}

        // Validar en servidor y anclar cookie de sesión PHP para las llamadas AJAX posteriores
        fetch('app/api/exiros.php?method=validateSessionID', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({SessionID: sid})
        }).then(function (res) {
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return res.json();
        }).then(function (json) {
            if (!json || json.error) {
                window.location.replace(ERROR_URL);
            } else {
                // Establecer variables globales para PunchOut
                window.HOOK_URL = json.HOOK_URL || '';
                window.BrowserFormPostUrl = json.HOOK_URL || '';
                console.log('Sesión PunchOut validada, HOOK_URL:', window.HOOK_URL);
            }
        }).catch(function () {
            window.location.replace(ERROR_URL);
        });
    } catch (e) {
        window.location.replace(ERROR_URL);
    }
})();

</script>
<link rel="stylesheet" href="public/css/cotizar.css">
<script src="{{'public/js/src/CompraRapida.js'|filemtime_version}}"></script>
<script src="{{'public/js/src/b2bProducts.js'|filemtime_version}}"></script>
<script src="public/js/src/tutorial.js"></script>
{% endblock %}