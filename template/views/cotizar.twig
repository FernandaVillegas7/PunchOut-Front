{% extends "layouts/base.twig" %}

{% block extraStyles %}

<style type="text/css">
    
.zoom-img-wrapper {
    overflow: hidden;      
    position: relative;        
    max-width: 16rem;  
}

.zoom-img {
    width: 100%;          
    transition: transform 0.3s ease;
    object-fit: cover;
    display: block;
}

.zoom-img-wrapper:hover .zoom-img {
    transform: scale(2.2);
}

/* Select2 responsiveness and dropdown sizing */
.select2-container { width: 100% !important; }
.select2-dropdown { max-width: 100% !important; }
.select2-results__options { max-height: 280px; overflow-y: auto; }

</style>

{% endblock %}

{% block pageContent %}  

<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-md-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" href="index">Inicio</a>
                <a class="breadcrumb-item text-dark" href="shop">Tienda</a>
                <span class="breadcrumb-item active">Compra rapida</span>
            </nav>
        </div>
    </div>
</div>

<div class="container-fluid pb-5">
    <div class="row px-xl-5">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <form id="frmArticulos">
                        <div class="row g-3">
                            <div class="col-12 col-md-8">
                                <div class="form-group">
                                    <label for="articulo">Articulo</label>
                                    <select class="form-select" name="articulo" id="articulo">
                                        <option value="-1">- Articulos -</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-6 col-md-2">
                                <div class="form-group">
                                    <label for="cantidad">Cantidad</label>
                                    <input class="form-control" type="text" id="cantidad" name="cantidad">
                                </div>
                            </div>
                            <div class="col-6 col-md-2 d-flex align-items-end">
                                <div class="form-group w-100">
                                    <button class="btn btn-dark w-100" id="btnAgregar" tooltip="Agregar a la lista">
                                        <i class="fa-solid fa-cart-plus"></i> Agregar a la lista
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>

                    <table class="table table-hover text-center mb-0 mt-4" id="tbListItems">
                        <thead class="border">
                            <th>#</th>
                            <th>supplierPartID</th>
                            <th class="d-none">buyerPartID</th> {# oculto #}
                            <th class="d-none">supplierPartAuxiliaryID</th> {# oculto #}
                            <th class="d-none">currency</th>
                            <th class="d-none">shortName</th>
                            <th>unitOfMeasure</th>
                            <th>category</th>
                            <th class="d-none">codigoInterno</th> {# oculto #}
                            <th>longName</th>
                            <th>manufacturer</th>
                            <th>manufacturerModelNumber</th>
                            <th class="d-none">materialGroup</th> {# oculto #}
                            <th>amount</th>
                            <th>imagen</th>
                            <th>&nbsp;</th>
                        </thead>
                        <tbody id="itemList">
                            <tr>
                                <td colspan="8">No se ha ingresado ningun articulo</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="section-title position-relative text-uppercase mb-3">
                        <span class="pr-3">Resumen</span>
                    </h5>
                    <div class="d-flex justify-content-between mt-2">
                        <h5>Total</h5>
                        <h5 id="totalItems">$ 0.00</h5>
                    </div>
                    <button class="btn btn-dark w-100 mt-3" id="btnEnviarOCI" tooltip="Procesar pedido">
                        <i class="fa-solid fa-cash-register"></i> Procesar Pedido
                    </button>
                    {# <button class="btn btn-outline-primary w-100 mt-2"  tooltip="Enviar OCI al PunchOut">
                        <i class="fa-solid fa-share-from-square"></i> Enviar OCI
                    </button> #}
                    <div id="jsonPreviewContainer" class="mt-3" style="display:none;">
                        <h6 class="text-muted mb-2">Vista previa JSON</h6>
                        <pre id="jsonPreview" class="bg-light p-2 small border rounded mb-0" style="max-height: 320px; overflow: auto;"></pre>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}

