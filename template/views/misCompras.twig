{% extends "layouts/base.twig" %}

{% block extraStyles %}
<style type="text/css">
  .money { white-space: nowrap; }
  .skeleton { opacity: .6; }
</style>
{% endblock %}

{% block pageContent %}
<section>
  <div class="container py-4">

    <div class="d-flex align-items-center justify-content-between mb-3">
      <div>
        <h1 class="h4 mb-1">Mis compras</h1>
        <p class="text-muted mb-0">Historial de órdenes y detalle de artículos</p>
      </div>
    </div>

    {# Filtros #}
    <form class="row g-2 align-items-end mb-3">
      <div class="col-12 col-md-3">
        <label class="form-label">Buscar</label>
        <input type="text" class="form-control" id="buscarCliente" placeholder="Ingrese cliente">
      </div>
       <div class="col-2 col-md-3">
        <label class="form-label">Buscar por</label>
        <input type="text" class="form-control" id="buscarFolio" placeholder="Folio cotización, carrito, etc">
      </div>
      <div class="col-6 col-md-1">
        <label class="form-label">Desde</label>
        <input type="date" class="form-control" id="fechaDesde">
      </div>
      <div class="col-6 col-md-1">
        <label class="form-label">Hasta</label>
        <input type="date" class="form-control" id="fechaHasta">
      </div>
      <div class="col-6 col-md-2">
        <label class="form-label" for="selectEstatus">Estatus</label>
        <select class="form-select" id="selectEstatus">
          <option value="">Todos</option>
         
        </select>
      </div>
      <div class="col-6 col-md-2 d-grid">
        <button type="button" class="btn btn-danger" id="btnAplicarFiltro">Aplicar</button>
      </div>
     

    </form>
    


    {# Contenedor donde se pinta el acordeón #}
    {# <div id="comprasRoot"
         data-api="/B2B-EXIROS-FRONT/app/api/misCompras.php"

         > #}
         <div id="comprasRoot"
         data-api="/B2B-EXIROS-FRONT/app/api/misCompras.php"

         >
      <div class="text-center text-muted py-5 skeleton">Ingresa un cliente para comenzar</div>
    </div>

  </div>
</section>
{% endblock %}

{% block extraScripts %}
{{ parent() }}
<script src="{{ 'public/js/src/MisCompras.js' | filemtime_version }}"></script>
{% endblock %}
