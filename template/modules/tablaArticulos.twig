
    {% set subTotal = 0 %}
    {% set iva = 0 %}
    {% set granTotal = 0 %}
    {% for i in itemsList %}
    {% set total = (i.Cantidad * i.Precio) %}
    {% set subTotal = subTotal + total %}
    <tr>
        <td class="text-start">
            <img src="https://mersolsureste.com.mx/articulos/index.php?clave={{i.CodigoProducto}}&img={{i.Articulo}}" alt=""
                style="width: 50px;">
            {{i.NombreProducto}}
        </td>
        <td class="align-middle">$ {{ i.Precio|number_format(0, '.', '') }}</td>
        <td class="align-middle">
            <div class="input-group quantity mx-auto" style="width: 100px;">
                <div class="input-group-btn">
                    <button class="btn btn-sm btn-secondary btn-minus">
                        <i class="fa fa-minus"></i>
                    </button>
                </div>
                <input type="text" class="form-control form-control-sm bg-secondary border-0 text-center"
                    value="{{i.Cantidad}}">
                <div class="input-group-btn">
                    <button class="btn btn-sm btn-secondary btn-plus">
                        <i class="fa fa-plus"></i>
                    </button>
                </div>
            </div>
        </td>
        <td class="align-middle">$ {{total}}</td>
        <td class="align-middle">
            <button class="btn btn-sm btn-danger-custom-small dropItem" data-id="{{i.CarritoID}}">
                <i class="fa fa-times"></i>
            </button>
        </td>
    </tr>
    {% endfor %}


