<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" href="index">Inicio</a>
                <a class="breadcrumb-item text-dark" href="shop">Tienda</a>
                <span class="breadcrumb-item active">Detalles del producto</span>
            </nav>
        </div>
    </div>
</div>


<div class="container-fluid pb-5">
    <div class="row px-xl-5">
        <div class="col-lg-5 mb-30">
            <div id="product-details" class="carousel slide" data-ride="carousel">
                <div class="prduct-details">
                    <img class="img-fluid w-100" src="{{ producto.pictures[0].url }}" alt="{{ producto.name }}" style="aspect-ratio: 1/1;">
                </div>
            </div>
        </div>

        <div class="col-lg-7 h-auto mb-30">
            <div class="h-100 p-30">
                <h3>
                    {{ producto.articulo }} - {{ producto.brand }}
                </h3>
                <h3 class="font-weight-semi-bold mb-4">
                    ${{ producto.priceData.salePrice }} {{ producto.priceData.currencyIso }}
                </h3>
                <p> 
                    {{ producto.description }}
                    <br>
                    <small>Codigo: {{ producto.code }}</small>
                </p>

                <form id="frmProducto">
                    <input type="hidden" name="codigo" value="{{ producto.code }}">
                    <input type="hidden" name="nombre" value="{{ producto.name }}">
                    <input type="hidden" name="precio" value="{{ producto.priceData.salePrice }}">
                    <input type="hidden" name="articulo" value="{{ producto.articulo }}">
                
                    <div class="d-flex align-items-center mb-4 pt-2">
                        <div class="row">
                            <div class="col-md-4 quantity">
                                <div class="input-group mb-3 pt-2">
                                    <button class="btn btn-outline-danger btn-minus" type="button" id="button-addon1">
                                        <i class="fa fa-minus"></i>
                                    </button>
                                    <input type="text" name="totalProducto" id="totalProducto" class="form-control text-center" placeholder="" aria-label="Cantidad" value="1" aria-describedby="button-addon1">
                                    <button class="btn btn-outline-danger btn-plus" type="button" id="button-addon2">
                                        <i class="fa fa-plus"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="col-md-8">
                                <button class="btn btn-danger px-3 ml-4" id="btAddCar">
                                    <i class="fas fa-cart-plus "></i>
                                    Agregar al carrito
                                </button>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="mt-4">
                    <div class="nav nav-tabs mb-4 text-white">
                        <a class="nav-item nav-link  active border " data-toggle="tab" href="#tab-pane-1">
                            Detalles
                        </a>
                        {# <a class="nav-item nav-link active border" data-toggle="tab" href="#tab-pane-3">
                            Ficha tecnica
                        </a> #}
                    </div>

                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="tab-pane-1">
                            <h4 class="mb-3">
                                {{ producto.articulo }} - {{ producto.brand }}
                            </h4>
                            <p>
                                {{ producto.description }}
                            </p>
                    
                            {# <div class="row">
                                <div class="col-md-4">
                                    <div class="list-group">
                                        <a href="#" class="list-group-item list-group-item-action">
                                            <div class="d-flex w-100 justify-content-between">
                                                <h5 class="mb-1">Peso</h5>
                                                <small class="text-muted">{{ producto.dimensiones.peso }} kg</small>
                                            </div>
                                        </a>
                                        <a href="#" class="list-group-item list-group-item-action">
                                            <div class="d-flex w-100 justify-content-between">
                                                <h5 class="mb-1">Alto</h5>
                                                <small class="text-muted">{{ producto.dimensiones.alto }} cm</small>
                                            </div>
                                        </a>
                                        <a href="#" class="list-group-item list-group-item-action">
                                            <div class="d-flex w-100 justify-content-between">
                                                <h5 class="mb-1">Ancho</h5>
                                                <small class="text-muted">{{ producto.dimensiones.ancho }} cm</small>
                                            </div>
                                        </a>
                                        <a href="#" class="list-group-item list-group-item-action">
                                            <div class="d-flex w-100 justify-content-between">
                                                <h5 class="mb-1">Largo</h5>
                                                <small class="text-muted">{{ producto.dimensiones.longitud }} cm</small>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                            </div> #}
                        </div>
                    
                        <div class="tab-pane fade" id="tab-pane-3"></div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
{% block extraScripts %}
<script src="{{'public/js/src/carrito.js'|filemtime_version}}"></script>
{% endblock %}